# 天气：open_meteo（默认，实时天气）或 mock（离线/自动化测试）
WEATHER_PROVIDER=open_meteo

# 地图：配置高德 Web 服务 Key 后，auto（默认）会自动启用高德；
# 未提供 Key 或上游故障时会自动回退内置 Mock。
MAP_PROVIDER=auto
AMAP_API_KEY=

# 列车工具：默认 apihz，调用真实余票与时刻数据。仅在离线测试时设为 mock。
TRAIN_PROVIDER=apihz
# 接口盒子免费账号的“个人资料”中取得；仅供后端 Agent 列车工具使用。
APIHZ_USER_ID=
APIHZ_API_KEY=

# 仅用于手动运行真实服务集成测试。
RUN_LIVE_API_TESTS=0
